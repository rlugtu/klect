# --- Supabase Postgres ---
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by Prisma for migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Realtime (direct-message delivery) ---
# Used to broadcast a tiny content-free "new activity" ping so clients refetch DMs in
# near-real-time. All four are OPTIONAL — if unset, DMs still work via polling. Values come
# from the Supabase project's API settings (Project URL + anon/public key).
#   Server (broadcasts the ping):
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
#   Browser client (subscribes) — must be NEXT_PUBLIC_ to reach the bundle:
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- better-auth ---
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Dev = http://localhost:3000. In production this MUST be the exact public origin the clients call,
# including the mobile app's EXPO_PUBLIC_API_URL (https://klect.vercel.app). It sets the Google OAuth
# redirect_uri; if it points at a different domain, mobile Google login completes but loads the web
# app instead of returning to the native app via the klect:// deep link.
BETTER_AUTH_URL="http://localhost:3000"

# --- Google OAuth (from Google Cloud Console) ---
# Authorized redirect URIs must include <BETTER_AUTH_URL>/api/auth/callback/google for EVERY deployed
# origin (e.g. https://klect.vercel.app/api/auth/callback/google), or Google returns redirect_uri_mismatch.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Mapbox (location autocomplete via Search Box API; token from mapbox.com) ---
# Server-side only — never prefix with NEXT_PUBLIC_. A public pk.* token works. Feature
# degrades to plain text if unset.
MAPBOX_TOKEN=""

# --- LinkPreview (link autofill extraction; API key from linkpreview.net) ---
# Primary generic unfurler for pasted links. Server-side only. If unset, autofill
# falls back to Microlink (free, IP-rate-limited).
LINKPREVIEW_API_KEY=""

# --- Social-media link enrichment (Instagram / TikTok / Facebook) ---
# Scraping API that returns the real caption + media for social-video links (e.g.
# ScrapeCreators / EnsembleData). Server-side only. If unset, social links fall back
# to the generic Microlink unfurl.
SOCIAL_SCRAPER_TOKEN=""
# Anthropic API key — comprehension layer (claude-haiku-4-5). Turns scraped social
# captions AND raw link metadata into clean title/location/description/tags. If unset,
# the raw caption / raw page metadata is used as-is (autofill still works).
ANTHROPIC_API_KEY=""

# --- Expo push notifications (mobile lockscreen alerts + app-icon badge) ---
# OPTIONAL. When set (create at expo.dev → Account → Access Tokens), the server includes it
# when sending Expo pushes so a leaked server can't impersonate you. Push still works if unset.
# Delivery no-ops entirely when no devices are registered, so leaving this blank is fine for web/CI.
EXPO_ACCESS_TOKEN=""

# --- EmailJS (transactional email: waitlist welcome + password reset) ---
# OPTIONAL. Sends via a mailbox you connect in the EmailJS dashboard (Gmail/Outlook/SMTP),
# so no domain/DNS is needed. The service id + both keys and the relevant template id must
# be set for a given mail to send; if any is blank that send no-ops cleanly (the signup /
# the reset request still succeeds), so leaving them blank is fine for local/CI.
# In the dashboard: connect a service, create a template whose "To Email" is {{to_email}},
# and under Account → API Keys enable "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
# Second template, for the forgot-password email. Same {{to_email}} "To Email" field, plus
# {{reset_url}} as the link the user clicks. Without it, "Forgot password?" silently sends
# nothing (the page still shows its generic confirmation), so set it before launch.
EMAILJS_RESET_PASSWORD_TEMPLATE_ID=""

# --- RevenueCat (subscription webhook: POST /api/webhooks/revenuecat) ---
# Supplied once the RevenueCat project exists (Stage 2 in IMPLEMENTATION_PLAN.md at the
# repo root). Blank until then, and the endpoint fails closed while it is blank: every
# delivery is rejected rather than trusted, so no half-configured webhook can write
# entitlements. Set it and the endpoint is live with no code change.
# The dashboard offers two ways to authenticate a delivery and this one value covers
# either, so use whichever is enabled:
#   - HMAC signing (preferred): paste the signing secret shown once when you enable it.
#   - Authorization header: paste the header value EXACTLY as typed into the dashboard,
#     including any "Bearer " prefix. The whole string is what gets compared.
REVENUECAT_WEBHOOK_SECRET=""

# --- RevenueCat (web paywall: /upgrade -> GET /api/checkout) ---
# Stage 7 in IMPLEMENTATION_PLAN.md at the repo root. All three come from the same
# RevenueCat dashboard, once the Stripe / Web Billing connection in Stage 2 is made.
# Blank is a supported state: /upgrade still renders, the buy buttons are visibly
# disabled, and nothing throws. Nothing is charged and no code changes when they land.
#
# Public (publishable) Web Billing key. Client-exposed on purpose: it is the half of
# the key pair meant to ship to a browser, and it is what @revenuecat/purchases-js
# would be configured with if in-page checkout ever replaces the hosted link.
NEXT_PUBLIC_REVENUECAT_WEB_BILLING_API_KEY=""
# The Web Purchase Link from the dashboard. Either the full URL
# (https://pay.rev.cat/abc123) or just the token (abc123) works. The signed-in user's
# Klect User.id is appended as the App User ID, which is what the Stage 5 webhook
# resolves event.app_user_id against. Without it, a payment never grants pro.
# Set the link's success / redirect URL in the dashboard to /upgrade/success.
NEXT_PUBLIC_REVENUECAT_WEB_PURCHASE_LINK=""
# Server-only secret key. Used for exactly one read-only question, on the post-checkout
# success screen: "does RevenueCat think this user is pro yet?", so the few seconds
# before the webhook lands don't read as a failed payment. Never consulted on a write
# path and never a fallback entitlement check: the local Entitlement row stays the
# source of truth. Blank just makes that screen say "still processing".
REVENUECAT_SECRET_API_KEY=""
